# Copy thanh .env (KHONG commit .env). Moodle phai cau hinh cung ENGINE_API_KEY
# tai: Site administration > Plugins > Local plugins > AI Micro-learning.
ENGINE_API_KEY=change-me-to-a-long-random-string

# Google AI Studio (Gemini) - LiteLLM doc bien nay
GEMINI_API_KEY=AIzaSy...

# Model (dinh dang LiteLLM: <provider>/<model>)
TEXT_MODEL=gemini/gemini-3.5-flash-lite
VISION_MODEL=gemini/gemini-3.5-flash-lite

# Gioi han dau vao
MAX_UPLOAD_MB=50
MAX_PAGES=300

# OCR (Tesseract). De trong TESSERACT_CMD neu tesseract da co trong PATH.
OCR_ENABLED=true
OCR_LANG=vie+eng
TESSERACT_CMD=

# Chi phi / rate limit
MAX_VISION_PAGES=20
CHUNK_SIZE=6000
CHUNK_OVERLAP=300
MAX_CHUNKS=40
QUESTIONS_PER_CHUNK=5
FLASHCARDS_PER_CHUNK=4
LLM_MAX_RETRIES=3

