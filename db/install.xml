<?xml version='1.0' encoding='utf-8'?>
<XMLDB PATH="local/microlearning/db" VERSION="20261028" COMMENT="Microlearning proposed initial schema">
  <TABLES>
    <TABLE NAME="local_microlearning_docs" COMMENT="docs records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10" />
        <FIELD NAME="courseid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="userid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="title" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="255" />
        <FIELD NAME="materialtype" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="fileid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="status" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20" DEFAULT="READY" />
        <FIELD NAME="visibility" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20" DEFAULT="CLASS_ONLY" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="1" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id" />
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" />
        <KEY NAME="fileid" TYPE="foreign" FIELDS="fileid" REFTABLE="files" REFFIELDS="id" />
      </KEYS>
    </TABLE>
    <TABLE NAME="local_microlearning_tasks" COMMENT="tasks records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10" />
        <FIELD NAME="docid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="requestedby" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="requestkey" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="64" />
        <FIELD NAME="inputhash" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="64" />
        <FIELD NAME="outputs" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="30" />
        <FIELD NAME="status" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20" DEFAULT="QUEUED" />
        <FIELD NAME="attempts" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="errorcode" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="100" />
        <FIELD NAME="startedat" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="finishedat" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="docid" TYPE="foreign" FIELDS="docid" REFTABLE="local_microlearning_docs" REFFIELDS="id" />
        <KEY NAME="requestedby" TYPE="foreign" FIELDS="requestedby" REFTABLE="user" REFFIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="requester-key" UNIQUE="true" FIELDS="requestedby, requestkey" />
      </INDEXES>
    </TABLE>
